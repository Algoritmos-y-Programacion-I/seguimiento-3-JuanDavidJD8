package model;

import java.time.LocalDate;
import java.util.ArrayList;

public class SchoolController {
    private static final int PISOS = 5;
    private static final int COMPUTERS_POR_PISOS = 10;
    
    
    private Computer[][] computersMatrix;
    private ArrayList<Computer> computersList;
    private ArrayList<Incident> allIncidents;

    public SchoolController() {
        computersMatrix = new Computer[PISOS][COMPUTERS_POR_PISOS];
        computersList = new ArrayList<>();
        allIncidents = new ArrayList<>();
    }


    public String agregarComputador(String numeroSerial, int pisoUsuario) {
        int piso = pisoUsuario - 1;
        
        for (Computer computer : computersList) {
            if (computer.getNumeroSerial().equals(numeroSerial)) {
                return "Error: El numero de serie ya existe en el sistema.";
            }
        }
                if (piso < 0 || piso >= PISOS) {
            return "Error: El piso debe estar entre 1 y 5.";
        }
        
    
        for (int posicion = 0; posicion < COMPUTERS_POR_PISOS; posicion++) {
            if (computersMatrix[piso][posicion] == null) {
  
                Computer computer = new Computer(numeroSerial, true, piso, posicion);
                
   
                computersMatrix[piso][posicion] = computer;
                computersList.add(computer);
                
                return "Computador agregado exitosamente en Piso " + pisoUsuario + ", Posicion " + (posicion + 1);
            }
        }
        
        return "Error: No hay espacio disponible en el piso " + pisoUsuario;
    }

    public String agregarIncidenteEnComputador(String numeroSerial, int pisoUsuario, int posicionUsuario, String descripcion) {
  
        int piso = pisoUsuario - 1;
        int posicion = posicionUsuario - 1;
        
    
        if (piso < 0 || piso >= PISOS || posicion < 0 || posicion >= COMPUTERS_POR_PISOS) {
            return "Error: Ubicacion invalida.";
        }
        

        Computer computer = computersMatrix[piso][posicion];
        

        if (computer == null) {
            return "Error: No hay computador en esa ubicacion.";
        }
        if (!computer.getNumeroSerial().equals(numeroSerial)) {
            return "Error: El numero de serie no coincide con el computador en esa ubicacion.";
        }

        Incident incident = new Incident(LocalDate.now(), descripcion);
        computer.addIncident(incident);
        allIncidents.add(incident);
        
        return "Incidente reportado exitosamente al computador " + numeroSerial;
    }

  
    public String consultarComputadorConMasIncidentes() {
        if (computersList.isEmpty()) {
            return "No hay computadores registrados en el sistema.";
        }
        
        Computer computadorConMasIncidentes = null;
        int maxIncidentes = -1;
        
        for (Computer computer : computersList) {
            if (computer.getIncidentCount() > maxIncidentes) {
                maxIncidentes = computer.getIncidentCount();
                computadorConMasIncidentes = computer;
            }
        }
        if (computadorConMasIncidentes == null || maxIncidentes == 0) {
            return "No hay incidentes reportados en ningun computador.";
        }
        
        // Convertir índices internos a números de usuario
        int pisoUsuario = computadorConMasIncidentes.getPiso() + 1;
        int posicionUsuario = computadorConMasIncidentes.getPosicion() + 1;
        
        return "Computador con mas incidentes:\n" +
               "Serial: " + computadorConMasIncidentes.getNumeroSerial() + "\n" +
               "Ubicacion: Piso " + pisoUsuario + ", Posicion " + posicionUsuario + "\n" +
               "Numero de incidentes: " + maxIncidentes;
    }

    // Getter para la vista
    public ArrayList<Computer> getComputerList() {
        return computersList;
    }
}


