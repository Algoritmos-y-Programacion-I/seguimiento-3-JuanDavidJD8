package model;

import java.util.ArrayList;

public class Computer {
    private String numeroSerial;
    private boolean enOperacion; 
    private int piso;
    private int posicion; 
    private ArrayList<Incident> incidents;

    public Computer(String numeroSerial, boolean enOperacion, int piso, int posicion) {
        this.numeroSerial = numeroSerial;
        this.enOperacion = enOperacion;
        this.piso = piso;
        this.posicion = posicion;
        this.incidents = new ArrayList<>();
    }

    public void addIncident(Incident incident) {
        this.incidents.add(incident);
    }

    // Getters
    public String getNumeroSerial(){ 
        return numeroSerial; 
    }
    public boolean getEnOperacion(){
        return enOperacion; 
    }
    public int getPiso(){ 
        return piso; 
    }
    public int getPosicion(){ 
        return posicion; 
    }
    public ArrayList<Incident> getIncidents(){ 
        return incidents; 
    }
    public int getIncidentCount(){ return incidents.size(); 
    }

    // Setters
    public void setEnOperacion(boolean enOperacion){ 
        this.enOperacion = enOperacion; 
    }
}


